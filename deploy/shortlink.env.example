# shortlink environment for the systemd unit.
#
#   sudo install -d -m 0750 -o shortlink -g shortlink /etc/shortlink
#   sudo install -m 0600 -o shortlink -g shortlink \
#     deploy/shortlink.env.example /etc/shortlink/shortlink.env
#   sudo $EDITOR /etc/shortlink/shortlink.env
#
# Values here are read by systemd, not by a shell: no `export`, no quotes
# needed unless a value contains spaces. Lines starting with # are comments.
#
# This file holds secrets. Keep it out of version control; .gitignore already
# covers .env.
#
# Any flag from `shortlink -h` is also readable as SHORTLINK_<FLAG>:
# -log-level -> SHORTLINK_LOG_LEVEL, -db -> SHORTLINK_DB. A flag passed on the
# command line in the unit file always wins over a value set here. The two
# exceptions keep their historical names: TS_AUTHKEY and NETBIRD_API_TOKEN.

# ---- secrets ----------------------------------------------------------------

# tailnet mode only, and only needed on the very first login: tsnet stores node
# credentials under -state-dir, so dropping this after the first start is safe.
# Create one at https://login.tailscale.com/admin/settings/keys
#TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# netbird mode only. Create one in the NetBird dashboard under Users -> Me ->
# API tokens; read access to peers and users is enough.
#NETBIRD_API_TOKEN=nbp_xxxxxxxxxxxxxxxx

# ---- logging ----------------------------------------------------------------

# debug also logs every redirect (each click on a link is one request) and
# tailscale chatter. Leave at info unless you are chasing something.
#SHORTLINK_LOG_LEVEL=info

# json for shippers, text for a terminal. Logs go to stderr, which the unit
# forwards to the journal.
#SHORTLINK_LOG_FORMAT=text

# ---- service ----------------------------------------------------------------

# The mode the unit starts in. The unit's ExecStart deliberately does not pass
# -mode, so this is the one place to change it (netbird needs NETBIRD_API_TOKEN
# above). tailnet is the default.
#SHORTLINK_MODE=tailnet

# MagicDNS name to advertise in tailnet mode.
#SHORTLINK_HOSTNAME=go

# false (the default) means only the owner of a link may edit or delete it, plus
# anyone with an admin grant. true turns ownership checks off: every caller may
# edit every link, though ownership is still recorded.
#SHORTLINK_OPEN=false

# Admin rights come from the network, not from this file: in tailnet mode from
# a tailnet ACL grant on tailscale.com/cap/shortlink, in netbird mode from
# membership in the group named below. Leave this line out to keep the default
# group; set it to an empty value to grant admin rights to nobody in netbird
# mode.
#SHORTLINK_NETBIRD_ADMIN_GROUP=shortlink-admin
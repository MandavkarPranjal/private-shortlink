[Unit]
Description=shortlink — private golink-style URL shortener
Documentation=https://github.com/MandavkarPranjal/private-shortlink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shortlink
Group=shortlink

# Secrets and settings live here; mode 0600, owned by shortlink.
# TS_AUTHKEY / NETBIRD_API_TOKEN go in this file for tailnet and netbird mode.
# See deploy/shortlink.env.example.
EnvironmentFile=/etc/shortlink/shortlink.env

# The state directory must be writable by the service user: the SQLite
# database, its WAL sidecars, the tsnet node state and the tailcat key file all
# land under it. The key file is written 0600.
StateDirectory=shortlink
WorkingDirectory=/var/lib/shortlink

ExecStart=/usr/local/bin/shortlink \
  -mode tailnet \
  -db /var/lib/shortlink/shortlink.db \
  -state-dir /var/lib/shortlink/tsnet \
  -key-file /var/lib/shortlink/shortlink-tailcat.key

# tsnet and netbird mode need to create a TUN device (tailnet mode embeds a
# node) or bind an existing WireGuard interface. Both require capabilities that
# the default bounding set does not grant, and the database must be writable.
# Drop every other capability, then re-add only what the chosen mode needs:
#
#   tailcat / local  no capabilities needed at all
#   tailnet          AmbientCapabilities=CAP_NET_ADMIN
#                    (tsnet creates /dev/net/tun)
#   netbird          AmbientCapabilities=CAP_NET_BIND_SERVICE
#                    (binds port 80 on the mesh interface; add CAP_NET_ADMIN
#                    only if netbird mode also needs to manage the interface)
#
# With a port below 1024, also grant CAP_NET_BIND_SERVICE. Override the list per
# instance with `systemctl edit shortlink`.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening. The process needs no kernel tunables, a real uid is already
# enforced by User=, and it does not talk to systemd outside of this unit.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# PrivateDevices must stay off in tailnet mode: it replaces /dev with a minimal
# one that has no /dev/net/tun, and tsnet opens the TUN device to build the
# embedded node. DevicePolicy is closed instead, so the service still reaches
# only the devices it needs.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/random r

# If tailnet mode logs something about a blocked syscall, drop SystemCallFilter
# for this instance with `systemctl edit shortlink`; the rest of the sandbox
# stays in place.

# Binding port 80 as non-root needs the capability above; the state directory
# is owned by shortlink so no chown dance is needed.
ReadWritePaths=/var/lib/shortlink

# Restart on failure, not on clean exit: a SIGTERM shutdown is success.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Logs go to the journal; `-log-format json` in the env file switches to
# structured output for shippers.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shortlink

# Keep a private /tmp namespace but let Go write the socket it needs.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
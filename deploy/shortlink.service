[Unit]
Description=shortlink — private golink-style URL shortener
Documentation=https://github.com/MandavkarPranjal/private-shortlink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shortlink
Group=shortlink

# Secrets and settings live here; mode 0600, owned by shortlink.
# TS_AUTHKEY / NETBIRD_API_TOKEN go in this file for tailnet and netbird mode.
# See deploy/shortlink.env.example.
EnvironmentFile=/etc/shortlink/shortlink.env

# The state directory must be writable by the service user: the SQLite
# database, its WAL sidecars, the tsnet node state and the tailcat key file all
# land under it. The key file is written 0600.
StateDirectory=shortlink
WorkingDirectory=/var/lib/shortlink

# No -mode here on purpose: the mode belongs in the environment file, where
# SHORTLINK_MODE is easy to change without editing this unit. A flag on the
# command line wins over the environment, so adding one here would silently
# override SHORTLINK_MODE and make it look broken.
ExecStart=/usr/local/bin/shortlink \
  -db /var/lib/shortlink/shortlink.db \
  -state-dir /var/lib/shortlink/tsnet \
  -key-file /var/lib/shortlink/shortlink-tailcat.key

# Every other capability is dropped and only CAP_NET_BIND_SERVICE is re-added:
#
#   tailcat / tailnet   none needed. tsnet embeds a userspace network stack; it
#                       creates no TUN device and needs no elevated rights.
#   netbird / local     CAP_NET_BIND_SERVICE only if binding a port below 1024.
#                       netbird mode binds a port on the host's existing
#                       WireGuard interface, it does not create one.
#
# Override the list per instance with `systemctl edit shortlink`.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening. The process needs no kernel tunables, a real uid is already
# enforced by User=, and it does not talk to systemd outside of this unit.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# No mode here needs a device. tsnet's network stack is userspace (gVisor), so
# tailnet mode opens no TUN; netbird mode binds a port on the host's existing
# WireGuard interface and does not manage the device. DevicePolicy=closed
# therefore costs nothing and still keeps the process away from /dev/kvm,
# /dev/mem and friends.
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/random r

# If tailnet mode logs something about a blocked syscall, drop SystemCallFilter
# for this instance with `systemctl edit shortlink`; the rest of the sandbox
# stays in place.

# Binding port 80 as non-root needs the capability above; the state directory
# is owned by shortlink so no chown dance is needed.
ReadWritePaths=/var/lib/shortlink

# Restart on failure, not on clean exit: a SIGTERM shutdown is success.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Logs go to the journal; `-log-format json` in the env file switches to
# structured output for shippers.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shortlink

# Keep a private /tmp namespace but let Go write the socket it needs.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target